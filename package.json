{
  "name": "wordhug",
  "version": "0.6.0",
  "description": "Keep [bracketed phrases] together on one line in React, Vue, Solid, Svelte, Astro and markdown by wrapping them in inline-block spans.",
  "license": "MIT",
  "author": "Cody Ta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codyta/wordhug.git"
  },
  "homepage": "https://github.com/codyta/wordhug#readme",
  "bugs": {
    "url": "https://github.com/codyta/wordhug/issues"
  },
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "react": [
        "./dist/react.d.ts"
      ],
      "vue": [
        "./dist/vue.d.ts"
      ],
      "solid": [
        "./dist/solid.d.ts"
      ],
      "svelte": [
        "./dist/svelte/index.d.ts"
      ],
      "rehype": [
        "./dist/rehype.d.ts"
      ],
      "astro": [
        "./dist/astro/index.d.ts"
      ]
    }
  },
  "imports": {
    "#markup": "./dist/markup.js"
  },
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./react": {
      "import": {
        "types": "./dist/react.d.ts",
        "default": "./dist/react.js"
      },
      "require": {
        "types": "./dist/react.d.cts",
        "default": "./dist/react.cjs"
      }
    },
    "./vue": {
      "import": {
        "types": "./dist/vue.d.ts",
        "default": "./dist/vue.js"
      },
      "require": {
        "types": "./dist/vue.d.cts",
        "default": "./dist/vue.cjs"
      }
    },
    "./solid": {
      "import": {
        "types": "./dist/solid.d.ts",
        "default": "./dist/solid.js"
      },
      "require": {
        "types": "./dist/solid.d.cts",
        "default": "./dist/solid.cjs"
      }
    },
    "./svelte": {
      "types": "./dist/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    },
    "./rehype": {
      "import": {
        "types": "./dist/rehype.d.ts",
        "default": "./dist/rehype.js"
      },
      "require": {
        "types": "./dist/rehype.d.cts",
        "default": "./dist/rehype.cjs"
      }
    },
    "./astro": {
      "types": "./dist/astro/index.d.ts",
      "default": "./dist/astro/index.js"
    },
    "./package.json": "./package.json"
  },
  "keywords": [
    "react",
    "vue",
    "solid",
    "svelte",
    "astro",
    "markdown",
    "rehype",
    "rehype-plugin",
    "text",
    "line-break",
    "no-wrap",
    "inline-block",
    "brackets"
  ],
  "scripts": {
    "build": "tsup && node scripts/copy-components.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build",
    "changeset": "changeset",
    "bench": "node scripts/bench-rich-text.mjs",
    "check:package": "node scripts/check-package.mjs && publint --strict && attw --pack . --exclude-entrypoints astro --ignore-rules cjs-resolves-to-esm",
    "test:browser": "vitest run -c vitest.browser.config.ts"
  },
  "peerDependencies": {
    "@solidjs/web": ">=2",
    "react": ">=18",
    "solid-js": ">=2",
    "svelte": ">=5",
    "vue": ">=3.3"
  },
  "peerDependenciesMeta": {
    "@solidjs/web": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    },
    "svelte": {
      "optional": true
    },
    "vue": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@changesets/cli": "^3.0.3",
    "@solidjs/web": "^2.0.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/browser-playwright": "^5.1.1",
    "astro": "^7.4.13",
    "jsdom": "^31.0.1",
    "playwright": "^1.65.1",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "solid-js": "^2.0.3",
    "svelte": "^5.58.0",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "unified": "^11.0.5",
    "vitest": "^5.1.1",
    "vue": "^3.5.45"
  }
}
