---
// Renders `text`, or the children when there is no `text`, so that every
// [bracketed phrase] is wrapped in an element (an inline-block span by default)
// that moves to the next line as one unit.
import { wordhugHtml } from "wordhug";
// Not exported from the package: `#markup` is a private import (package.json `imports`).
import { wordhugMarkup } from "#markup";

export interface Props {
  /** Text to render. `[...]` groups are kept together on one line. Without it, the children are rendered. */
  text?: string | null | undefined;
  /** Tag name used to wrap each group. Defaults to `"span"`. */
  as?: string;
  /** Class for each group wrapper. */
  class?: string;
  /** Style attribute for each group wrapper. Defaults to `"display: inline-block"`; `null` removes it. */
  style?: string | null;
}

const { text, as, class: className, style } = Astro.props;
const options = { as, class: className, style };

// Astro hands over children only as rendered HTML, so they are read with
// `wordhugMarkup`, which finds brackets in the text and leaves the markup alone.
const html =
  text != null
    ? wordhugHtml(text, options)
    : Astro.slots.has("default")
      ? wordhugMarkup(await Astro.slots.render("default"), options)
      : "";
---

<Fragment set:html={html} />
